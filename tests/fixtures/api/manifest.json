    "namespace": "92a2f024-d515-547f-b6ea-0928d339dca3",
    "namespaceDerivedFrom": "uuid5(NAMESPACE_DNS, 'fixtures.omarchy-unifi.invalid')",
    "note": "RFC 2606 reserves .invalid permanently, so this namespace can never correspond to a real host. Every uuid below is uuid5(namespace, label) and is therefore reproducible from this file alone (SEC-011 / AC-059)."
  },
  "pagination": {
    "accept_boundary_200": {
      "expect": "accept",
      "note": "Exactly 200 records: one page filled to the API maximum limit. The terminal page is FULL, so a reader that stops only on a short page loops forever here.",
      "responses": 1,
      "synthesized": false
    },
    "accept_boundary_201": {
      "expect": "accept",
      "note": "201 records: the first record past the limit, so page two holds exactly one.",
      "responses": 2,
      "synthesized": false
    },
    "accept_empty_collection": {
      "expect": "accept",
      "note": "A genuinely empty collection: count == 0 AND totalCount == 0, which DATA-009b makes a COMPLETE result. The empty site is exactly the site whose owner is setting the plugin up for the first time.",
      "responses": 1,
      "synthesized": false
    },
    "accept_single_page_25": {
      "expect": "accept",
      "note": "25 records: one page, at the >25 default-limit boundary.",
      "responses": 1,
      "synthesized": false
    },
    "accept_three_pages_413": {
      "expect": "accept",
      "note": "413 records over three pages (200 + 200 + 13).",
      "responses": 3,
      "synthesized": false
    },
    "advance_by_validated_count": {
      "expect": "advance_by_validated_count",
      "note": "The response echoes a limit of four when two was requested. Advancing by response arithmetic rather than the validated count skips records.",
      "responses": 3,
      "synthesized": false
    },
    "count_equals_data_length": {
      "expect": "count_equals_data_length",
      "note": "count says 1 while data holds 2.",
      "responses": 3,
      "synthesized": false
    },
    "count_within_limit": {
      "expect": "count_within_limit",
      "note": "A page returns three records for a limit of two.",
      "responses": 3,
      "synthesized": false
    },
    "empty_is_valid_not_premature": {
      "expect": "empty_is_valid_not_premature",
      "note": "count == 0 while offset < totalCount. Read together with accept_empty_collection this pair is the whole of DATA-009b; either one alone can be satisfied by a wrong rule.",
      "responses": 1,
      "synthesized": false
    },
    "max_decoded_bytes_enforced": {
      "expect": "max_decoded_bytes_enforced",
      "note": "Pages whose accumulated decoded size crosses the 8 MiB per-collection bound before the page count does. Synthesized, as above.",
      "responses": 64,
      "synthesized": true
    },
    "max_pages_enforced": {
      "expect": "max_pages_enforced",
      "note": "65 pages: one past the 64-page bound. A controller that never reports a terminal page must not hang the batch. Synthesized rather than committed — materialising it is 6 MB of near-identical records in a repository that gets cloned into the plugins directory on install.",
      "responses": 65,
      "synthesized": true
    },
    "non_terminal_page_progresses": {
      "expect": "non_terminal_page_progresses",
      "note": "A middle page is empty while offset < totalCount: premature, and the deliberate twin of accept_empty_collection.",
      "responses": 3,
      "synthesized": false
    },
    "offset_matches_request": {
      "expect": "offset_matches_request",
      "note": "Page 2 answers with offset 1 for a request at offset 2.",
      "responses": 3,
      "synthesized": false
    },
    "record_ids_unique": {
      "expect": "record_ids_unique",
      "note": "Two records on one page share an id, so accumulation reaches four unique records for a totalCount of five and never terminates.",
      "responses": 3,
      "synthesized": false
    },
    "reread_page_zero_matches": {
      "expect": "reread_page_zero_matches",
      "note": "OFFSET DRIFT AT CONSTANT CARDINALITY. One record is deleted and another appended after page 0 is read, so every later page slides by one and exactly one record is never returned. Offsets, counts, id uniqueness, totalCount stability and terminal completeness ALL still pass. The trailing response is the DATA-009a re-read of page 0, which is the only thing in the contract that catches this.",
      "responses": 4,
      "synthesized": false
    },
    "terminal_completeness": {
      "expect": "terminal_completeness",
      "note": "The collection terminates on a short page with fewer unique records accumulated than the terminal totalCount claims: 3 against 5.",
      "responses": 2,
      "synthesized": false
    },
    "total_count_non_negative": {
      "expect": "total_count_non_negative",
      "note": "A negative totalCount.",
      "responses": 3,
      "synthesized": false
    },
    "total_count_stable": {
      "expect": "total_count_stable",
      "note": "totalCount changes between the first page and the last.",
      "responses": 3,
      "synthesized": false
    }
  },
